# ==============================================================================
# AGORA, ABOGADOS — Environment Configuration Example
# ==============================================================================

# Canonical Site URL (Used for sitemaps, robots, open graph metadata)
# Default development fallback: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Calendar Appointment Schedule Public Booking URL
# Leave empty to test the graceful booking preparation fallback
NEXT_PUBLIC_BOOKING_URL=

# ==============================================================================
# Phase 12 — AGORA AI Chat Engine Subsystem (Default: Disabled)
# ==============================================================================
# Feature flag to activate the AI Chat subsystem in client (true | false)
NEXT_PUBLIC_AI_CHAT_ENABLED=false

# Operating mode for the AI engine (disabled | private | client-pilot | public)
AI_CHAT_MODE=disabled

# Server-side secret token required when AI_CHAT_MODE=private (Header: x-agora-ai-auth)
# AI_CHAT_PRIVATE_SECRET=

# Server-side secret used to sign short-lived client-pilot sessions (optional, falls back to private secret)
# AI_CHAT_PILOT_SECRET=

# AI provider type (local | gemini | unavailable)
AI_PROVIDER=local

# Server-side API key for Google Gemini (NEVER expose with NEXT_PUBLIC_)
# AI_API_KEY=
# GEMINI_API_KEY=

# Server-side model identifier for Google Gemini (default: gemini-flash-latest)
# GEMINI_MODEL=gemini-flash-latest
